RewriteEngine on
RewriteBase /

# Maintenance mode
# RewriteCond %{REQUEST_URI} ^/maintenancePage.php
# RewriteRule .* - [L]
# RewriteRule .* /maintenancePage.php [L]

# Forbid access to any dot file
RewriteRule ^(.*/)?\..+ - [R=404,L]

# Explicitely redirect any URL starting with /public_html/
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^public_html/(.*)$ /$1 [L,R=303]

# Iternally rebase all urls to the /public_html/ folder
RewriteCond %{REQUEST_URI} !^/public_html/
RewriteRule ^(.*)$ public_html/$1
